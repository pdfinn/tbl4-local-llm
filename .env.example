# Model to download and use (change to any model from https://ollama.com/library)
# Smaller models run faster. Recommended for most laptops:
#   llama3.2       - 3B parameters, good all-around (default)
#   phi3:mini      - 3.8B parameters, good for coding
#   mistral        - 7B parameters, needs 8GB+ RAM
MODEL=llama3.2

# Port for the web interface (change if 3000 is already in use)
WEBUI_PORT=3000

# Secret used to encrypt OAuth credentials for MCP tools so they survive a
# container restart. The setup script generates a random value on first run;
# leave blank and do not commit a real value.
WEBUI_SECRET_KEY=
